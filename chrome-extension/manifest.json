{
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ollamapaca Chrome"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "page.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "description": "Discover WebMCP tools on pages you allow, and share them with a local Ollamapaca plugin server. WebMCP tools are page-declared only, and never give generic control of a page that did not register them.",
  "host_permissions": [
    "http://127.0.0.1:11435/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "manifest_version": 3,
  "name": "Ollamapaca Chrome",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "version": "0.1.0"
}
