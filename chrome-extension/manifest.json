{
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ollamapaca Chrome"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    },
    {
      "js": [
        "page.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "description": "Lets a local Ollamapaca model control this browser (open tabs, read pages, click, type) through the local plugin executor on 127.0.0.1, and shares page-declared WebMCP tools for sites you allow. Nothing leaves your machine.",
  "host_permissions": [
    "http://127.0.0.1:11435/*",
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "manifest_version": 3,
  "name": "Ollamapaca Chrome",
  "permissions": [
    "activeTab",
    "alarms",
    "debugger",
    "scripting",
    "storage",
    "tabs"
  ],
  "version": "0.2.0"
}
